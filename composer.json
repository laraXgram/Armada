{
    "name": "laraxgram/armada",
    "description": "Docker files for running and deploying LaraGram applications and Telegram Bot API servers.",
    "keywords": [
        "laragram",
        "docker",
        "telegram-bot-api",
        "armada"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/laraxgram/armada/issues",
        "source": "https://github.com/laraxgram/armada"
    },
    "authors": [
        {
            "name": "AmirHkrg",
            "email": "amirh.kargar85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laraxgram/core": "^4.7"
    },
    "bin": [
        "bin/armada"
    ],
    "autoload": {
        "psr-4": {
            "LaraGram\\Armada\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.x-dev"
        },
        "laragram": {
            "providers": [
                "LaraGram\\Armada\\ArmadaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
