#!/bin/sh
set -eu

if [ -z "${TELEGRAM_API_ID:-}" ] || [ -z "${TELEGRAM_API_HASH:-}" ]; then
    echo "The Bot API server needs API_ID and API_HASH. Create them at https://my.telegram.org and add them to your .env file." >&2
    exit 1
fi

# The application reads downloaded files from this directory, so both containers must run as the same user...
uid="${WWWUSER:-1000}"
gid="${WWWGROUP:-1000}"

# File streaming and file storage follow the application's API_STREAM_FILES and API_FILE_STORAGE...
truthy() {
    case "$(echo "${1:-}" | tr '[:upper:]' '[:lower:]')" in
        1|true|on|yes) return 0 ;;
        *) return 1 ;;
    esac
}

if truthy "${API_STREAM_FILES:-false}"; then
    set -- --stream-files --stream-read-ahead="${API_STREAM_READ_AHEAD:-4}" "$@"
fi

if ! truthy "${API_FILE_STORAGE:-true}"; then
    set -- --no-file-storage "$@"
fi

mkdir -p /var/lib/bot-api /tmp/bot-api
chown -R "$uid:$gid" /var/lib/bot-api /tmp/bot-api

exec gosu "$uid:$gid" laragram-server \
    --local \
    --dir=/var/lib/bot-api \
    --temp-dir=/tmp/bot-api \
    --http-port=8081 \
    --http-stat-port=8082 \
    --verbosity="${BOT_API_VERBOSITY:-1}" \
    "$@"
