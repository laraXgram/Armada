#!/usr/bin/env bash

UNAMEOUT="$(uname -s)"

# Verify operating system is supported...
case "${UNAMEOUT}" in
    Linux*)             MACHINE=linux;;
    Darwin*)            MACHINE=mac;;
    *)                  MACHINE="UNKNOWN"
esac

if [ "$MACHINE" == "UNKNOWN" ]; then
    echo "Unsupported operating system [$(uname -s)]. LaraGram Armada supports macOS, Linux, and Windows (WSL2)." >&2

    exit 1
fi

# Determine if stdout is a terminal...
if test -t 1; then
    # Determine if colors are supported...
    ncolors=$(tput colors)

    if test -n "$ncolors" && test "$ncolors" -ge 8; then
        BOLD="$(tput bold)"
        YELLOW="$(tput setaf 3)"
        GREEN="$(tput setaf 2)"
        NC="$(tput sgr0)"
    fi
fi

# Function that prints the available commands...
function display_help {
    echo "LaraGram Armada"
    echo
    echo "${YELLOW}Usage:${NC}" >&2
    echo "  armada COMMAND [options] [arguments]"
    echo
    echo "Unknown commands are passed to the docker-compose binary."
    echo
    echo "${YELLOW}docker-compose Commands:${NC}"
    echo "  ${GREEN}armada up${NC}        Start the application"
    echo "  ${GREEN}armada up -d${NC}     Start the application in the background"
    echo "  ${GREEN}armada stop${NC}      Stop the application"
    echo "  ${GREEN}armada restart${NC}   Restart the application"
    echo "  ${GREEN}armada ps${NC}        Display the status of all containers"
    echo
    echo "${YELLOW}Commander Commands:${NC}"
    echo "  ${GREEN}armada laragram ...${NC}          Run a Commander command"
    echo "  ${GREEN}armada laragram queue:work${NC}"
    echo "  ${GREEN}armada probe${NC}                 Start a new Probe session"
    echo "  ${GREEN}armada watchdog${NC}              Tail the application logs"
    echo
    echo "${YELLOW}Bot API Server:${NC}"
    echo "  ${GREEN}armada bot-api status${NC}    Display the status of the Bot API server"
    echo "  ${GREEN}armada bot-api logs${NC}      Follow the logs of the Bot API server"
    echo "  ${GREEN}armada bot-api restart${NC}   Restart the Bot API server"
    echo "  ${GREEN}armada bot-api logout${NC}    Log the bot out of the cloud Bot API"
    echo
    echo "${YELLOW}PHP Commands:${NC}"
    echo "  ${GREEN}armada php ...${NC}   Run a snippet of PHP code"
    echo "  ${GREEN}armada php -v${NC}"
    echo
    echo "${YELLOW}Composer Commands:${NC}"
    echo "  ${GREEN}armada composer ...${NC}                       Run a Composer command"
    echo "  ${GREEN}armada composer require laraxgram/surge${NC}"
    echo
    echo "${YELLOW}Node Commands:${NC}"
    echo "  ${GREEN}armada node ...${NC}   Run a Node command"
    echo "  ${GREEN}armada npm ...${NC}    Run a npm command"
    echo "  ${GREEN}armada npx${NC}        Run a npx command"
    echo "  ${GREEN}armada pnpm ...${NC}   Run a pnpm command"
    echo "  ${GREEN}armada pnpx${NC}       Run a pnpx command"
    echo "  ${GREEN}armada yarn ...${NC}   Run a Yarn command"
    echo "  ${GREEN}armada bun ...${NC}    Run a bun command"
    echo "  ${GREEN}armada bunx${NC}       Run a bunx command"
    echo
    echo "${YELLOW}Database Commands:${NC}"
    echo "  ${GREEN}armada mysql${NC}     Start a MySQL CLI session within the 'mysql' container"
    echo "  ${GREEN}armada mariadb${NC}   Start a MySQL CLI session within the 'mariadb' container"
    echo "  ${GREEN}armada psql${NC}      Start a PostgreSQL CLI session within the 'pgsql' container"
    echo "  ${GREEN}armada mongodb${NC}   Start a Mongo Shell session within the 'mongodb' container"
    echo "  ${GREEN}armada redis${NC}     Start a Redis CLI session within the 'redis' container"
    echo "  ${GREEN}armada valkey${NC}    Start a Valkey CLI session within the 'valkey' container"
    echo
    echo "${YELLOW}Debugging:${NC}"
    echo "  ${GREEN}armada debug ...${NC}   Run a Commander command in debug mode"
    echo "  ${GREEN}armada debug queue:work${NC}"
    echo
    echo "${YELLOW}Container CLI:${NC}"
    echo "  ${GREEN}armada shell${NC}        Start a shell session within the application container"
    echo "  ${GREEN}armada bash${NC}         Alias for 'armada shell'"
    echo "  ${GREEN}armada root-shell${NC}   Start a root shell session within the application container"
    echo "  ${GREEN}armada root-bash${NC}    Alias for 'armada root-shell'"
    echo
    echo "${YELLOW}Binaries:${NC}"
    echo "  ${GREEN}armada bin ...${NC}   Run Composer binary scripts from the vendor/bin directory"
    echo "  ${GREEN}armada run ...${NC}   Run a command within the application container"
    echo
    echo "${YELLOW}Production:${NC}"
    echo "  ${GREEN}armada prod ...${NC}   Run any Armada command against compose.production.yaml"
    echo "  ${GREEN}armada prod up -d${NC}"
    echo
    echo "${YELLOW}Customization:${NC}"
    echo "  ${GREEN}armada laragram armada:publish${NC}   Publish the Armada configuration files"
    echo "  ${GREEN}armada build --no-cache${NC}          Rebuild all of the Armada containers"

    exit 1
}

# Proxy the "help" command...
if [ $# -gt 0 ]; then
    if [ "$1" == "help" ] || [ "$1" == "-h" ] || [ "$1" == "-help" ] || [ "$1" == "--help" ]; then
        display_help
    fi
else
    display_help
fi

# Source the ".env" file so LaraGram's environment variables are available...
# shellcheck source=/dev/null
if [ -n "$APP_ENV" ] && [ -f ./.env."$APP_ENV" ]; then
    source ./.env."$APP_ENV";
elif [ -f ./.env ]; then
    source ./.env;
fi

# Target the production Compose file...
PRODUCTION="no"

if [ "$1" == "prod" ]; then
    shift 1

    [ $# -eq 0 ] && display_help

    PRODUCTION="yes"
    ARMADA_FILES="compose.production.yaml"
    APP_SERVICE="app"
    APP_USER="armada"
fi

# Define environment variables...
export APP_PORT=${APP_PORT:-80}
export APP_SERVICE=${APP_SERVICE:-"laragram.test"}
export APP_USER=${APP_USER:-"armada"}
export DB_PORT=${DB_PORT:-3306}
export WWWUSER=${WWWUSER:-$UID}
export WWWGROUP=${WWWGROUP:-$(id -g)}

export ARMADA_FILES=${ARMADA_FILES:-""}
export ARMADA_DOCKER_BINARY=${ARMADA_DOCKER_BINARY:-"docker"}

# Function that outputs Armada is not running...
function armada_is_not_running {
    echo "${BOLD}Armada is not running.${NC}" >&2
    echo "" >&2
    echo "${BOLD}You may start Armada using the following commands:${NC} './vendor/bin/armada up' or './vendor/bin/armada up -d'" >&2

    exit 1
}

# Define Docker Compose command prefix...
if ${ARMADA_DOCKER_BINARY} compose &> /dev/null; then
    COMPOSE_CMD=("${ARMADA_DOCKER_BINARY}" compose)
else
    COMPOSE_CMD=("${ARMADA_DOCKER_BINARY}-compose")
fi

if [ -n "$ARMADA_FILES" ]; then
    # Convert ARMADA_FILES to an array...
    IFS=':' read -ra ARMADA_FILES <<< "$ARMADA_FILES"

    for FILE in "${ARMADA_FILES[@]}"; do
        if [ -f "$FILE" ]; then
            COMPOSE_CMD+=(-f "$FILE")
        else
            echo "${BOLD}Unable to find Docker Compose file: '${FILE}'${NC}" >&2

            exit 1
        fi
    done
fi

EXEC="yes"

if [ -z "$ARMADA_SKIP_CHECKS" ]; then
    # Ensure that Docker is running...
    if ! ${ARMADA_DOCKER_BINARY} info > /dev/null 2>&1; then
        echo "${BOLD}Docker or Podman is not running.${NC}" >&2

        exit 1
    fi

    # Determine if Armada is currently up...
    if [ "$PRODUCTION" == "no" ] && "${COMPOSE_CMD[@]}" ps "$APP_SERVICE" 2>&1 | grep 'Exit\|exited'; then
        echo "${BOLD}Shutting down old Armada processes...${NC}" >&2

        "${COMPOSE_CMD[@]}" down > /dev/null 2>&1

        EXEC="no"
    elif [ -z "$("${COMPOSE_CMD[@]}" ps -q)" ]; then
        EXEC="no"
    fi
fi

ARGS=()

# Run a command inside of a running container...
function exec_in {
    [ "$EXEC" == "yes" ] || armada_is_not_running

    ARGS+=(exec)
    [ ! -t 0 ] && ARGS+=(-T)
    ARGS+=("$@")
}

# Run a command inside of the application container...
function exec_in_app {
    [ "$EXEC" == "yes" ] || armada_is_not_running

    ARGS+=(exec -u "$APP_USER")
    [ ! -t 0 ] && ARGS+=(-T)
    ARGS+=("$APP_SERVICE" "$@")
}

# Log the bot out of the cloud Bot API so it can be used with a local server...
function bot_api_logout {
    if [ -z "$BOT_TOKEN" ]; then
        echo "${BOLD}BOT_TOKEN is not set in your .env file.${NC}" >&2

        exit 1
    fi

    if [ "$1" != "--force" ]; then
        echo "This logs the bot out of api.telegram.org. It cannot log back in there for 10 minutes."
        read -r -p "Do you want to continue? [y/N] " CONFIRM

        if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
            exit 0
        fi
    fi

    # The token is passed through stdin to keep it out of the process list...
    printf 'url = "https://api.telegram.org/bot%s/logOut"\n' "$BOT_TOKEN" | curl -sS --config -
    echo
}

case "$1" in
    # Proxy PHP commands to the "php" binary on the application container...
    php)
        shift 1
        exec_in_app php
        ;;

    # Proxy vendor binary commands on the application container...
    bin)
        shift 1
        CMD=$1
        shift 1
        exec_in_app ./vendor/bin/"$CMD"
        ;;

    # Proxy commands on the application container...
    run)
        shift 1
        CMD=$1
        shift 1
        exec_in_app "$CMD"
        ;;

    # Proxy Composer commands to the "composer" binary on the application container...
    composer)
        shift 1
        exec_in_app composer
        ;;

    # Proxy Commander commands to the "laragram" binary on the application container...
    laragram|lg)
        shift 1

        if [ "$1" == "schedule:run" ]; then
            ARGS+=(-T)
        fi

        exec_in_app php laragram
        ;;

    # Run a Commander command with Xdebug enabled...
    debug)
        shift 1
        [ "$EXEC" == "yes" ] || armada_is_not_running
        ARGS+=(exec -u "$APP_USER" -e XDEBUG_TRIGGER=1)
        [ ! -t 0 ] && ARGS+=(-T)
        ARGS+=("$APP_SERVICE" php laragram)
        ;;

    # Initiate a Probe session within the application container...
    probe)
        shift 1
        exec_in_app php laragram probe
        ;;

    # Tail the application logs...
    watchdog)
        shift 1
        exec_in_app php laragram watchdog
        ;;

    # Manage the Bot API server container...
    bot-api)
        shift 1

        case "${1:-status}" in
            status)
                "${COMPOSE_CMD[@]}" ps bot-api
                ;;
            logs)
                "${COMPOSE_CMD[@]}" logs -f bot-api
                ;;
            restart)
                "${COMPOSE_CMD[@]}" restart bot-api
                ;;
            logout)
                bot_api_logout "$2"
                ;;
            *)
                echo "Unknown bot-api command [$1]. Available commands: status, logs, restart, logout." >&2

                exit 1
                ;;
        esac

        exit
        ;;

    # Proxy Node, NPM, PNPM, Yarn and Bun commands to the application container...
    node|npm|npx|pnpm|pnpx|yarn|bun|bunx)
        CMD=$1
        shift 1
        exec_in_app "$CMD"
        ;;

    # Initiate a MySQL CLI terminal session within the "mysql" container...
    mysql)
        shift 1
        exec_in mysql bash -c "MYSQL_PWD=\${MYSQL_PASSWORD} mysql -u \${MYSQL_USER} \${MYSQL_DATABASE} \${MYSQL_EXTRA_OPTIONS}"
        ;;

    # Initiate a MySQL CLI terminal session within the "mariadb" container...
    mariadb)
        shift 1
        exec_in mariadb bash -c "MYSQL_PWD=\${MYSQL_PASSWORD} mariadb -u \${MYSQL_USER} \${MYSQL_DATABASE}"
        ;;

    # Initiate a PostgreSQL CLI terminal session within the "pgsql" container...
    psql)
        shift 1
        exec_in pgsql bash -c "PGPASSWORD=\${PGPASSWORD} psql -U \${POSTGRES_USER} \${POSTGRES_DB}"
        ;;

    # Initiate a MongoDB Shell within the "mongodb" container...
    mongodb)
        shift 1
        exec_in mongodb mongosh --port 27017 --username "$MONGODB_USERNAME" --password "$MONGODB_PASSWORD" --authenticationDatabase admin
        ;;

    # Initiate a Redis CLI terminal session within the "redis" container...
    redis)
        shift 1
        exec_in redis redis-cli
        ;;

    # Initiate a Valkey CLI terminal session within the "valkey" container...
    valkey)
        shift 1
        exec_in valkey valkey-cli
        ;;

    # Initiate a Bash shell within the application container...
    shell|bash)
        shift 1
        exec_in_app bash
        ;;

    # Initiate a root user Bash shell within the application container...
    root-shell|root-bash)
        shift 1
        [ "$EXEC" == "yes" ] || armada_is_not_running
        ARGS+=(exec -u root)
        [ ! -t 0 ] && ARGS+=(-T)
        ARGS+=("$APP_SERVICE" bash)
        ;;
esac

# Forward the host terminal's color capability to container commands...
if [ "${ARGS[0]:-}" == "exec" ] && [ -n "${COLORTERM:-}" ]; then
    ARGS=(exec -e "COLORTERM=${COLORTERM}" "${ARGS[@]:1}")
fi

# Run Docker Compose with the defined arguments...
"${COMPOSE_CMD[@]}" "${ARGS[@]}" "$@"
