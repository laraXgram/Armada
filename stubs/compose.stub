# For more information: https://laraxgram.github.io/armada.html
services:
    laragram.test:
        build:
            context: ./vendor/laraxgram/armada/runtimes/{{PHP_VERSION}}
            dockerfile: Dockerfile
            args:
                WWWGROUP: '${WWWGROUP}'
        image: armada-{{PHP_VERSION}}/app
        extra_hosts:
            - 'host.docker.internal:host-gateway'
        ports:
            - '${APP_PORT:-80}:80'
        environment:
            WWWUSER: '${WWWUSER}'
            LARAGRAM_ARMADA: 1
            XDEBUG_MODE: '${ARMADA_XDEBUG_MODE:-off}'
            XDEBUG_CONFIG: '${ARMADA_XDEBUG_CONFIG:-client_host=host.docker.internal}'
            IGNITION_LOCAL_SITES_PATH: '${PWD}'
        volumes:
            - '.:/var/www/html'
        networks:
            - armada
networks:
    armada:
        driver: bridge
