docker-proxy:
    image: 'tecnativa/docker-socket-proxy:latest'
    environment:
        CONTAINERS: 1
        EXEC: 1
        INFO: 1
        VERSION: 1
        POST: 1
        ALLOW_START: 1
        ALLOW_STOP: 1
        ALLOW_RESTARTS: 1
    volumes:
        - '/var/run/docker.sock:/var/run/docker.sock:ro'
    networks:
        - armada
