// https://aka.ms/devcontainer.json
{
	"name": "LaraGram Armada",
	"dockerComposeFile": [
		"../compose.yaml"
	],
	"service": "laragram.test",
	"workspaceFolder": "/var/www/html",
	"customizations": {
		"vscode": {
			"extensions": [
			],
			"settings": {}
		}
	},
	"remoteUser": "armada",
	"postCreateCommand": "chown -R 1000:1000 /var/www/html 2>/dev/null || true"
	// "forwardPorts": [],
	// "runServices": [],
	// "shutdownAction": "none",
}
